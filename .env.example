# Tasty Hot Frontend — Environment Variables
# Copy this file and name it .env.local for local development.
# Set these same keys in Vercel's Environment Variables dashboard for production.
# NEVER commit .env.local to GitHub.

# Your deployed backend URL (change to Render URL in production)
VITE_API_URL=http://localhost:5000

# Firebase config (get these from Firebase Console → Project Settings → Your Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tastyhotweb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tastyhotweb
VITE_FIREBASE_STORAGE_BUCKET=tastyhotweb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://tastyhotweb-default-rtdb.europe-west1.firebasedatabase.app
