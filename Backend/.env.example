# Tasty Hot Backend — Environment Variables
# Copy this file and name it .env, then fill in the real values.
# NEVER commit .env to GitHub.

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://tastyhotweb-default-rtdb.europe-west1.firebasedatabase.app

# Paste the ENTIRE content of firebase-service-account.json as one line (for Render deployment)
# Leave blank when running locally (the file will be used instead)
FIREBASE_SERVICE_ACCOUNT=

# Gmail SMTP credentials for sending order receipts
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Environment: 'development' or 'production'
NODE_ENV=development

# Your Vercel frontend URL — used in production to restrict CORS
FRONTEND_URL=https://your-app.vercel.app
